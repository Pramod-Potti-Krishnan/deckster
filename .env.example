# Deckster Environment Variables

# Application Settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
PORT=8000  # Railway will auto-set this

# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here  # Optional but recommended

# AI Services (Required)
OPENAI_API_KEY=sk-...your-key-here

# AI Services (Optional)
ANTHROPIC_API_KEY=sk-ant-api03-...your-key-here  # Recommended for better performance

# Logging (Optional)
LOGFIRE_TOKEN=your-logfire-token  # For production monitoring

# Notes:
# - Copy this file to .env and fill in your actual values
# - Never commit .env to version control
# - All SUPABASE_* values come from your Supabase project settings
# - At least one AI service key (OpenAI or Anthropic) is required