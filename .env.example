# Deckster Environment Variables

# Application Settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
PORT=8000  # Railway will auto-set this

# Supabase Configuration (REQUIRED - Application will not start without these)
SUPABASE_URL=https://your-project.supabase.co  # Required: Get from Supabase project settings
SUPABASE_ANON_KEY=your-anon-key-here  # Required: Get from Supabase project API settings
SUPABASE_SERVICE_KEY=your-service-key-here  # Optional but recommended for admin operations

# AI Services (At least one required)
GOOGLE_API_KEY=  # Get from https://aistudio.google.com/apikey
OPENAI_API_KEY=sk-...your-key-here
ANTHROPIC_API_KEY=sk-ant-api03-...your-key-here  # Alternative to OpenAI

# Logging & Observability (Optional but Recommended)
LOGFIRE_TOKEN=your-logfire-write-token  # Get from https://logfire.pydantic.dev
LOGFIRE_ENVIRONMENT=development  # development, staging, or production
LOGFIRE_CONSOLE=false  # Set to true for console output during development
LOGFIRE_TRACE_SAMPLE_RATE=1.0  # 1.0 = 100% sampling (reduce in production)
LOGFIRE_SEND_TO_LOGFIRE=true  # Set to false to disable sending to Logfire

# Notes:
# - Copy this file to .env and fill in your actual values
# - Never commit .env to version control
# - All SUPABASE_* values come from your Supabase project settings
# - At least one AI service key (Google, OpenAI or Anthropic) is required